---
import { branches } from "@/data/branches";
import { company, createWhatsAppUrl } from "@/data/company";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
	title="Hubungi Kami (Kantor Pusat Makassar, Cabang Jayapura, Cabang Toraja) — CV. Skylander"
	description="Jika Anda memiliki pertanyaan atau ingin berbicara dengan Kami, jangan ragu untuk menghubungi Kami. Informasi kontak resmi CV. Skylander."
	canonicalPath="/contact"
>
	<!-- 1. EDITORIAL HEADER (Matching Stitch Subpage Style) -->
	<section class="py-12 sm:py-16 lg:py-20 bg-stone-50 border-b border-stone-200">
		<div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-12 space-y-5 sm:space-y-6">
			<div class="flex flex-wrap items-center gap-2 font-mono text-xs text-stone-500">
				<a href="/" class="hover:text-stone-900 transition-colors">Beranda</a>
				<span>/</span>
				<span class="text-amber-600 font-bold">Kontak</span>
			</div>

			<div class="space-y-3 max-w-4xl pt-2">
				<div class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-amber-600 font-bold">
					<span class="w-2 h-2 rounded-full bg-amber-500"></span>
					<span>Layanan Pelanggan &amp; Konsultasi Proyek</span>
				</div>
				<h1 class="font-heading font-extrabold text-2xl sm:text-3xl md:text-4xl lg:text-[52px] text-stone-900 tracking-tight leading-[1.1]">
					Hubungi Kami
				</h1>
				<p class="font-body text-sm sm:text-base lg:text-lg text-stone-600 leading-relaxed max-w-3xl">
					Jika Anda memiliki pertanyaan atau ingin berbicara dengan Kami, jangan ragu untuk menghubungi Kami. Silakan hubungi tim dukungan melalui informasi kontak berikut ini.
				</p>
			</div>
		</div>
	</section>

	<!-- 2. DIREKTORI KONTAK & KANTOR OPERASIONAL -->
	<section class="py-14 sm:py-20 bg-white border-b border-stone-200">
		<div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-12 space-y-14 sm:space-y-16">
			<!-- Quick Direct Contact Strip -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<a
					href={`tel:${company.phone}`}
					class="bg-stone-50 border border-stone-200 hover:border-amber-500 rounded-lg p-6 shadow-sm transition-colors flex items-start gap-4 group"
				>
					<div class="w-11 h-11 rounded bg-stone-950 text-amber-400 flex items-center justify-center shrink-0">
						<span class="material-symbols-outlined text-[20px]">call</span>
					</div>
					<div>
						<span class="font-mono text-[11px] uppercase tracking-widest text-stone-400 block">Telepon Kami</span>
						<span class="font-heading font-bold text-lg text-stone-900 group-hover:text-amber-600 transition-colors block mt-0.5">
							+6282342270000
						</span>
						<span class="font-body text-xs text-stone-500">Senin - Sabtu: 07.00 - 16.00</span>
					</div>
				</a>

				<a
					href={`mailto:${company.email}`}
					class="bg-stone-50 border border-stone-200 hover:border-amber-500 rounded-lg p-6 shadow-sm transition-colors flex items-start gap-4 group"
				>
					<div class="w-11 h-11 rounded bg-stone-950 text-amber-400 flex items-center justify-center shrink-0">
						<span class="material-symbols-outlined text-[20px]">mail</span>
					</div>
					<div>
						<span class="font-mono text-[11px] uppercase tracking-widest text-stone-400 block">Email Kami</span>
						<span class="font-heading font-bold text-lg text-stone-900 group-hover:text-amber-600 transition-colors block mt-0.5 break-all">
							{company.email}
						</span>
						<span class="font-body text-xs text-stone-500">Respon cepat hari kerja</span>
					</div>
				</a>

				<a
					href={createWhatsAppUrl("Halo CV. Skylander, saya ingin berkonsultasi mengenai rencana proyek.")}
					target="_blank"
					rel="noopener noreferrer"
					class="bg-stone-950 hover:bg-stone-900 border border-stone-800 rounded-lg p-6 shadow-sm transition-colors flex items-start gap-4 group"
				>
					<div class="w-11 h-11 rounded bg-amber-500 text-stone-950 flex items-center justify-center shrink-0">
						<span class="material-symbols-outlined text-[20px]">chat</span>
					</div>
					<div>
						<span class="font-mono text-[11px] uppercase tracking-widest text-amber-400 block">WhatsApp Resmi</span>
						<span class="font-heading font-bold text-lg text-white group-hover:text-amber-400 transition-colors block mt-0.5">
							Chat Tim Support
						</span>
						<span class="font-body text-xs text-stone-400">Konsultasi gratis &amp; estimasi proyek</span>
					</div>
				</a>
			</div>

			<!-- 3 Kantor Cabang (Makassar, Jayapura, Toraja) -->
			<div class="space-y-8">
				<div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
					<div class="space-y-2">
						<span class="font-heading text-xs uppercase tracking-[0.2em] text-amber-500 font-bold block">
							Jaringan Operasional
						</span>
						<h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-stone-900 tracking-tight">
							Kunjungi Kantor Kami
						</h2>
					</div>
					<p class="font-body text-sm text-stone-600 max-w-md">
						Kantor operasional dan studio teknis CV. Skylander melayani wilayah Makassar, Jayapura (Papua), dan Tana Toraja.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
					{branches.map((b, idx) => (
						<div class="bg-stone-50 border border-stone-200 rounded-lg p-7 shadow-sm flex flex-col justify-between gap-6 hover:border-amber-500/60 transition-colors">
							<div class="space-y-4">
								<span class="font-mono text-xs uppercase tracking-widest text-amber-600 font-bold block">
									0{idx + 1} • {b.type}
								</span>

								<h3 class="font-heading font-bold text-xl text-stone-900">
									{b.name}
								</h3>

								<p class="font-body text-sm text-stone-600 leading-relaxed">
									{b.address}
								</p>

								<div class="pt-2 text-xs font-mono text-stone-500 space-y-1">
									<div>Jam Kerja: {b.operatingHours}</div>
									<div>Minggu: Libur</div>
								</div>
							</div>

							<div class="pt-2 flex flex-col gap-2.5">
								<a
									href={createWhatsAppUrl(b.whatsappMessage)}
									target="_blank"
									rel="noopener noreferrer"
									class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-stone-900 hover:bg-amber-500 text-white hover:text-stone-950 font-heading font-bold text-xs uppercase tracking-wider rounded transition-colors"
								>
									<span class="material-symbols-outlined text-[16px] leading-none">chat</span>
									<span class="leading-none">Hubungi Kantor Ini</span>
								</a>
								<a
									href={b.mapsUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-white hover:bg-stone-100 text-stone-700 font-heading font-bold text-xs uppercase tracking-wider rounded transition-colors border border-stone-200"
								>
									<span class="material-symbols-outlined text-[16px] leading-none">map</span>
									<span class="leading-none">Buka Google Maps</span>
								</a>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
