---
import { createWhatsAppUrl } from "@/data/company";

interface Props {
	transparentOnTop?: boolean;
}

const { transparentOnTop = false } = Astro.props;
---

<!-- 1. HEADER / NAVBAR (Seamless Transparent at Top on All Pages, White Glass on Scroll) -->
<header
	id="site-navbar"
	data-dark-hero={transparentOnTop ? "true" : "false"}
	class={transparentOnTop
		? "fixed top-0 inset-x-0 z-50 bg-transparent border-b border-transparent transition-all duration-300"
		: "sticky top-0 z-50 bg-transparent border-b border-transparent transition-all duration-300"}
>
	<!-- Main Navigation Bar -->
	<div class="max-w-[1440px] mx-auto px-6 lg:px-12 h-20 flex items-center justify-between gap-6">
		<!-- Brand Logo -->
		<a class="flex items-center gap-3 group" href="/">
			<img
				alt="Logo CV. Skylander Construction Specialist"
				class="h-11 sm:h-12 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
				src="/images/original/skylander.co_.id_.webp"
			/>
		</a>

		<!-- Navigation Links with Dropdowns (Bahasa Indonesia) -->
		<nav class="hidden lg:flex items-center gap-8">
			<a
				data-nav-link
				class={`font-heading text-xs font-bold uppercase tracking-widest transition-colors ${
					transparentOnTop
						? "text-white hover:text-amber-400"
						: "text-stone-900 hover:text-amber-500"
				}`}
				href="/"
			>
				Beranda
			</a>

			<!-- PERUSAHAAN Dropdown -->
			<div class="relative group py-6">
				<button
					type="button"
					data-nav-link
					class={`flex items-center gap-1 font-heading text-xs font-semibold uppercase tracking-widest transition-colors ${
						transparentOnTop
							? "text-white/90 group-hover:text-amber-400"
							: "text-stone-700 group-hover:text-amber-600"
					}`}
				>
					<span>Perusahaan</span>
					<span class="material-symbols-outlined text-[16px] transition-transform duration-200 group-hover:rotate-180">expand_more</span>
				</button>
				<div class="absolute top-full left-0 w-60 bg-stone-950 text-white rounded-lg shadow-2xl border border-stone-800 py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 divide-y divide-stone-800/80">
					<a href="/about-us" class="block px-5 py-3 font-heading text-xs font-bold uppercase tracking-wider text-stone-200 hover:text-amber-400 hover:bg-stone-900 transition-colors">
						Tentang Kami
					</a>
					<a href="/legalitas-perusahaan" class="block px-5 py-3 font-heading text-xs font-bold uppercase tracking-wider text-stone-200 hover:text-amber-400 hover:bg-stone-900 transition-colors">
						Legalitas Perusahaan
					</a>
					<a href="/faq" class="block px-5 py-3 font-heading text-xs font-bold uppercase tracking-wider text-stone-200 hover:text-amber-400 hover:bg-stone-900 transition-colors">
						FAQ
					</a>
				</div>
			</div>

			<!-- LAYANAN Dropdown -->
			<div class="relative group py-6">
				<button
					type="button"
					data-nav-link
					class={`flex items-center gap-1 font-heading text-xs font-semibold uppercase tracking-widest transition-colors ${
						transparentOnTop
							? "text-white/90 group-hover:text-amber-400"
							: "text-stone-700 group-hover:text-amber-600"
					}`}
				>
					<span>Layanan</span>
					<span class="material-symbols-outlined text-[16px] transition-transform duration-200 group-hover:rotate-180">expand_more</span>
				</button>
				<div class="absolute top-full left-0 w-80 bg-stone-950 text-white rounded-lg shadow-2xl border border-stone-800 py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 divide-y divide-stone-800/80">
					<a href="/service/konstruksi-gedung-perkantoran" class="block px-5 py-3 font-heading text-xs font-bold uppercase tracking-wider text-stone-200 hover:text-amber-400 hover:bg-stone-900 transition-colors">
						Konstruksi Gedung Perkantoran
					</a>
					<a href="/service/konstruksi-bangunan-sipil" class="block px-5 py-3 font-heading text-xs font-bold uppercase tracking-wider text-stone-200 hover:text-amber-400 hover:bg-stone-900 transition-colors">
						Konstruksi Bangunan Sipil
					</a>
					<a href="/service/konstruksi-bangunan-hunian" class="block px-5 py-3 font-heading text-xs font-bold uppercase tracking-wider text-stone-200 hover:text-amber-400 hover:bg-stone-900 transition-colors">
						Konstruksi Bangunan Hunian
					</a>
					<a href="/service/konstruksi-prasarana-sumber-daya-air" class="block px-5 py-3 font-heading text-xs font-bold uppercase tracking-wider text-stone-200 hover:text-amber-400 hover:bg-stone-900 transition-colors">
						Konstruksi Prasarana Sumber Daya Air
					</a>
					<a href="/service/jasa-renovasi" class="block px-5 py-3 font-heading text-xs font-bold uppercase tracking-wider text-stone-200 hover:text-amber-400 hover:bg-stone-900 transition-colors">
						Jasa Renovasi
					</a>
					<a href="/service/jasa-desain-arsitektur" class="block px-5 py-3 font-heading text-xs font-bold uppercase tracking-wider text-stone-200 hover:text-amber-400 hover:bg-stone-900 transition-colors">
						Jasa Desain Arsitektur
					</a>
					<a href="/service/jasa-lanskap" class="block px-5 py-3 font-heading text-xs font-bold uppercase tracking-wider text-stone-200 hover:text-amber-400 hover:bg-stone-900 transition-colors">
						Pekerjaan Landscape &amp; Taman
					</a>
				</div>
			</div>

			<a
				data-nav-link
				class={`font-heading text-xs font-semibold uppercase tracking-widest transition-colors ${
					transparentOnTop
						? "text-white/90 hover:text-amber-400"
						: "text-stone-700 hover:text-amber-500"
				}`}
				href="/blog"
			>
				Blog
			</a>
			<a
				data-nav-link
				class={`font-heading text-xs font-semibold uppercase tracking-widest transition-colors ${
					transparentOnTop
						? "text-white/90 hover:text-amber-400"
						: "text-stone-700 hover:text-amber-500"
				}`}
				href="/contact"
			>
				Kontak
			</a>
		</nav>

		<!-- Language Toggle & Primary CTA -->
		<div class="flex items-center gap-4">
			<div
				id="nav-lang-box"
				class={`hidden sm:flex items-center font-mono text-xs rounded p-0.5 transition-all ${
					transparentOnTop
						? "border border-white/20 bg-white/10 backdrop-blur-md"
						: "border border-stone-200 bg-white/60 shadow-inner"
				}`}
			>
				<button
					type="button"
					data-lang-btn="id"
					class="px-2.5 py-1 bg-white text-stone-900 font-bold rounded shadow-sm transition-all cursor-pointer"
				>
					ID
				</button>
				<button
					type="button"
					data-lang-btn="en"
					class={`px-2.5 py-1 rounded cursor-pointer transition-all font-medium ${
						transparentOnTop
							? "text-white/80 hover:text-white"
							: "text-stone-500 hover:text-stone-900"
					}`}
				>
					EN
				</button>
			</div>
			<a
				id="nav-cta-btn"
				class={`inline-flex items-center justify-center gap-1.5 px-5 py-2.5 font-heading text-xs uppercase tracking-wider font-bold rounded transition-all duration-200 shadow-sm ${
					transparentOnTop
						? "bg-amber-500 hover:bg-amber-400 text-stone-950"
						: "bg-stone-900 hover:bg-amber-500 text-white hover:text-stone-950"
				}`}
				href={createWhatsAppUrl("Halo CV. Skylander, saya ingin berkonsultasi mengenai rencana proyek konstruksi / renovasi.")}
				target="_blank"
				rel="noopener noreferrer"
			>
				<span class="leading-none">Konsultasi Proyek</span>
				<span class="material-symbols-outlined text-[16px] leading-none">arrow_outward</span>
			</a>
		</div>
	</div>
</header>

<script>
	import { enTranslations, placeholderTranslations } from "@/data/i18n";

	function initSeamlessNavbarAndI18n() {
		const header = document.getElementById("site-navbar");
		const isDarkHero = header?.getAttribute("data-dark-hero") === "true";
		const navLinks = header?.querySelectorAll<HTMLElement>("[data-nav-link]") ?? [];
		const langBox = document.getElementById("nav-lang-box");
		const langBtns = document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]");
		const ctaBtn = document.getElementById("nav-cta-btn");

		let currentLang: "id" | "en" = "id";
		try {
			if (localStorage.getItem("skylander_lang") === "en") {
				currentLang = "en";
			}
		} catch {
			currentLang = "id";
		}

		// Build reverse dictionary for instant EN -> ID switching without reload
		const idTranslations: Record<string, string> = {};
		for (const [idText, enText] of Object.entries(enTranslations)) {
			idTranslations[enText] = idText;
		}
		const idPlaceholders: Record<string, string> = {};
		for (const [idPh, enPh] of Object.entries(placeholderTranslations)) {
			idPlaceholders[enPh] = idPh;
		}

		function normalizeText(str: string): string {
			return str.replace(/\s+/g, " ").trim();
		}

		function applyLanguage(lang: "id" | "en") {
			currentLang = lang;
			try {
				localStorage.setItem("skylander_lang", lang);
			} catch {
				// Ignore storage errors in private/restricted browsing modes
			}
			document.documentElement.lang = lang;

			const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
				acceptNode(node) {
					const parent = node.parentElement;
					if (!parent) return NodeFilter.FILTER_REJECT;
					const tag = parent.tagName;
					if (tag === "SCRIPT" || tag === "STYLE" || tag === "NOSCRIPT") {
						return NodeFilter.FILTER_REJECT;
					}
					if (parent.classList.contains("material-symbols-outlined")) {
						return NodeFilter.FILTER_REJECT;
					}
					return NodeFilter.FILTER_ACCEPT;
				},
			});

			const textNodes: Text[] = [];
			let currentNode = walker.nextNode();
			while (currentNode) {
				textNodes.push(currentNode as Text);
				currentNode = walker.nextNode();
			}

			for (const textNode of textNodes) {
				const raw = textNode.nodeValue || "";
				// Preserve multi-line FAQ answers
				const trimmed = raw.trim();
				if (!trimmed) continue;

				if (lang === "en") {
					const exactMulti = enTranslations[trimmed];
					const norm = normalizeText(raw);
					const translated = exactMulti ?? enTranslations[norm];
					if (translated) {
						textNode.nodeValue = translated;
					}
				} else {
					const exactMulti = idTranslations[trimmed];
					const norm = normalizeText(raw);
					const translated = exactMulti ?? idTranslations[norm];
					if (translated) {
						textNode.nodeValue = translated;
					}
				}
			}

			const inputs = document.querySelectorAll<HTMLInputElement>("input[placeholder]");
			inputs.forEach((inp) => {
				const ph = inp.getAttribute("placeholder") || "";
				if (lang === "en" && placeholderTranslations[ph]) {
					inp.setAttribute("placeholder", placeholderTranslations[ph]);
				} else if (lang === "id" && idPlaceholders[ph]) {
					inp.setAttribute("placeholder", idPlaceholders[ph]);
				}
			});

			updateNavbarState();
		}

		function updateNavbarState() {
			if (!header) return;
			const isScrolled = window.scrollY > 24;
			const useLightText = isDarkHero && !isScrolled;

			if (isScrolled) {
				header.classList.remove("bg-transparent", "border-transparent");
				header.classList.add("bg-white/95", "backdrop-blur-xl", "border-stone-200", "shadow-sm");
			} else {
				header.classList.add("bg-transparent", "border-transparent");
				header.classList.remove("bg-white/95", "backdrop-blur-xl", "border-stone-200", "shadow-sm");
			}

			navLinks.forEach((el, idx) => {
				if (useLightText) {
					el.classList.remove("text-stone-900", "text-stone-700", "hover:text-amber-500", "group-hover:text-amber-600");
					if (idx === 0) {
						el.classList.add("text-white", "hover:text-amber-400");
					} else {
						el.classList.add("text-white/90", "hover:text-amber-400", "group-hover:text-amber-400");
					}
				} else {
					el.classList.remove("text-white", "text-white/90", "hover:text-amber-400", "group-hover:text-amber-400");
					if (idx === 0) {
						el.classList.add("text-stone-900", "hover:text-amber-500");
					} else {
						el.classList.add("text-stone-700", "hover:text-amber-500", "group-hover:text-amber-600");
					}
				}
			});

			if (langBox) {
				if (useLightText) {
					langBox.classList.add("border-white/20", "bg-white/10", "backdrop-blur-md");
					langBox.classList.remove("border-stone-200", "bg-stone-100/80", "bg-white/60", "shadow-inner");
				} else {
					langBox.classList.remove("border-white/20", "bg-white/10", "backdrop-blur-md");
					langBox.classList.add("border-stone-200", "bg-stone-100/80", "shadow-inner");
				}
			}

			langBtns.forEach((btn) => {
				const btnLang = btn.getAttribute("data-lang-btn");
				const isActive = btnLang === currentLang;
				if (isActive) {
					btn.className =
						"px-2.5 py-1 bg-white text-stone-900 font-bold rounded shadow-sm transition-all cursor-pointer";
				} else if (useLightText) {
					btn.className =
						"px-2.5 py-1 rounded cursor-pointer transition-all font-medium text-white/80 hover:text-white";
				} else {
					btn.className =
						"px-2.5 py-1 rounded cursor-pointer transition-all font-medium text-stone-500 hover:text-stone-900";
				}
			});

			if (ctaBtn) {
				if (useLightText) {
					ctaBtn.classList.add("bg-amber-500", "hover:bg-amber-400", "text-stone-950");
					ctaBtn.classList.remove("bg-stone-900", "hover:bg-amber-500", "text-white", "hover:text-stone-950");
				} else {
					ctaBtn.classList.remove("bg-amber-500", "hover:bg-amber-400", "text-stone-950");
					ctaBtn.classList.add("bg-stone-900", "hover:bg-amber-500", "text-white", "hover:text-stone-950");
				}
			}
		}

		langBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const targetLang = btn.getAttribute("data-lang-btn") === "en" ? "en" : "id";
				if (targetLang !== currentLang) {
					applyLanguage(targetLang);
				}
			});
		});

		window.addEventListener("scroll", updateNavbarState, { passive: true });

		if (currentLang === "en") {
			applyLanguage("en");
		} else {
			updateNavbarState();
		}
	}

	initSeamlessNavbarAndI18n();
</script>
